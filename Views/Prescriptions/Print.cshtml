@model Prescription
@{ ViewData["Title"] = "Print Prescription"; }

<div class="page-heading no-print">
    <div><div class="page-kicker">Printable</div><h1>Prescription</h1></div>
    <button class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer me-2"></i>Print</button>
</div>

<div class="print-surface">
    <div class="print-document-header">
        <div class="d-flex align-items-center gap-3">
            <img class="print-logo" src="~/img/vlera-dent-logo.svg" alt="Vlera Dent" />
            <div>
                <h2 class="fw-bold mb-1">Vlera Dent</h2>
                <p class="mb-0 text-soft">Clinical prescription</p>
            </div>
        </div>
        <div class="text-end"><strong>Date</strong><br />@Model.PrescriptionDate.ToString("dd MMM yyyy")</div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6"><div class="print-info"><span>Patient</span><strong>@Model.PatientName</strong></div></div>
        <div class="col-md-6"><div class="print-info"><span>Dentist</span><strong>Dr. @Model.DoctorName</strong><small>License: @Model.DoctorLicenseNumber</small></div></div>
    </div>

    <div class="print-box mb-4">
        <span class="text-soft">Medication</span>
        <h3 class="fw-bold mb-0">@Model.MedicationName</h3>
    </div>

    <table class="table print-table">
        <tr><th>Dosage</th><td>@Model.Dosage</td></tr>
        <tr><th>Frequency</th><td>@Model.Frequency</td></tr>
        <tr><th>Duration</th><td>@Model.Duration</td></tr>
        <tr><th>Instructions</th><td>@Model.Instructions</td></tr>
    </table>

    <div class="print-signature-row">
        <div>Patient confirmation</div>
        <div>Dentist signature</div>
    </div>
</div>
