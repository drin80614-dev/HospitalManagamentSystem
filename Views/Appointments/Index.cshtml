@model AppointmentListViewModel
@{ ViewData["Title"] = "Appointments"; }
@functions {
    private static string? WhatsAppPhone(string? phone)
    {
        var digits = new string((phone ?? string.Empty).Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(digits))
        {
            return null;
        }

        if (digits.StartsWith("00"))
        {
            digits = digits[2..];
        }
        else if (digits.StartsWith("0"))
        {
            digits = "383" + digits[1..];
        }

        return digits.Length >= 8 ? digits : null;
    }

    private static string WhatsAppReminderText(Appointment item)
    {
        var service = item.ServiceNames ?? item.ServiceName ?? "kontrollen/trajtimin tuaj";
        return $"Pershendetje {item.PatientName}, ju rikujtojme terminin tuaj ne Vlera Dent me {item.AppointmentDate:dd.MM.yyyy} ora {item.AppointmentTime:hh\\:mm}. Sherbimi: {service}. Ju lutemi paraqituni me kohe. Faleminderit!";
    }
}

<div class="page-heading">
    <div><div class="page-kicker">Appointments</div><h1>Schedule</h1></div>
    @if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Receptionist))
    {
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-calendar-plus me-2"></i>Create appointment</a>
    }
    <a class="btn btn-outline-primary" asp-action="Calendar"><i class="bi bi-calendar3 me-2"></i>Calendar</a>
</div>

<form method="get" class="glass-panel p-3 mb-4">
    <div class="row g-3 align-items-end">
        @if (!User.IsInRole(AppRoles.Doctor))
        {
            <div class="col-md-4"><label class="form-label">Doctor</label><select class="form-select" name="doctorId"><option value="">All</option>@foreach (var d in Model.Doctors){<option value="@d.Id" selected="@(Model.DoctorId == d.Id)">@d.FullName</option>}</select></div>
        }
        <div class="col-md-3"><label class="form-label">Date</label><input class="form-control" type="date" name="date" value="@Model.Date?.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-3"><label class="form-label">Status</label><select class="form-select" name="status"><option value="">All</option>@foreach (var s in new[] { "Scheduled", "Waiting", "In Progress", "Completed", "Cancelled" }){<option selected="@(Model.Status == s)">@s</option>}</select></div>
        <div class="col-md-2 d-grid"><button class="btn btn-primary"><i class="bi bi-funnel me-2"></i>Filter</button></div>
    </div>
</form>

<div class="glass-panel p-3 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="fw-bold mb-0">Calendar view</h5>
            <div class="text-soft">Appointments grouped by day</div>
        </div>
        <span class="badge-soft">@Model.Appointments.Count total</span>
    </div>
    <div class="row g-3">
        @foreach (var group in Model.Appointments.GroupBy(a => a.AppointmentDate.Date).OrderBy(g => g.Key).Take(7))
        {
            <div class="col-md-6 col-xl">
                <div class="timeline-item h-100">
                    <i class="bi bi-calendar2-week text-primary"></i>
                    <div>
                        <strong>@group.Key.ToString("ddd, dd MMM")</strong>
                        <div class="text-soft">@group.Count() appointments</div>
                        <div class="small">@string.Join(", ", group.OrderBy(a => a.AppointmentTime).Take(3).Select(a => a.AppointmentTime.ToString(@"hh\:mm")))</div>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Appointments.Any())
        {
            <div class="col-12 text-soft">No appointments to show on the calendar.</div>
        }
    </div>
</div>

<div class="table-shell">
    <table class="table align-middle">
        <thead><tr><th>No.</th><th>Date</th><th>Patient</th><th>Doctor</th><th>Service</th><th>Reason</th><th>Status</th><th>Reminder</th><th class="text-end">Update</th></tr></thead>
        <tbody>
        @foreach (var item in Model.Appointments)
        {
            <tr>
                <td class="fw-bold">@item.AppointmentNumber</td>
                <td>@item.AppointmentDate.ToString("dd MMM yyyy")<br /><span class="text-soft">@item.AppointmentTime.ToString(@"hh\:mm")</span></td>
                <td>@item.PatientName</td>
                <td>@item.DoctorName<br /><span class="text-soft">@item.DoctorSpecialization</span></td>
                <td>
                    @(item.ServiceNames ?? item.ServiceName ?? "-")
                    @if ((item.ServicesTotal ?? item.ServicePrice).HasValue)
                    {
                        <br /><span class="text-soft">@((item.ServicesTotal ?? item.ServicePrice)!.Value.ToString("C"))</span>
                    }
                </td>
                <td>@item.Reason</td>
                <td><span class="badge-soft status-@item.Status.Replace(" ", "")">@item.Status</span></td>
                <td>
                    @if (item.ReminderSentAt.HasValue)
                    {
                        <span class="badge-soft status-Completed">Sent</span>
                        <div class="text-soft small">@item.ReminderSentAt.Value.ToString("dd MMM HH:mm")</div>
                    }
                    else
                    {
                        var phone = WhatsAppPhone(item.PatientPhone);
                        if (!string.IsNullOrWhiteSpace(phone))
                        {
                            <a class="btn btn-sm btn-outline-success" target="_blank" rel="noopener" href="https://wa.me/@phone?text=@Uri.EscapeDataString(WhatsAppReminderText(item))">
                                <i class="bi bi-whatsapp me-1"></i>WhatsApp
                            </a>
                            @if (item.ReminderStatus == "Failed")
                            {
                                <div class="text-danger small">Auto failed</div>
                            }
                        }
                        else
                        {
                            <span class="text-soft small">No phone</span>
                        }
                    }
                </td>
                <td class="text-end">
                    <form method="post" asp-action="Status" class="d-flex gap-2 justify-content-end">
                        <input type="hidden" name="id" value="@item.Id" />
                        <select class="form-select form-select-sm" name="status" style="max-width:160px">
                            @foreach (var s in new[] { "Scheduled", "Waiting", "In Progress", "Completed", "Cancelled" })
                            {
                                <option selected="@(item.Status == s)">@s</option>
                            }
                        </select>
                        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-check2"></i></button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Appointments.Any()) { <tr><td colspan="9" class="text-center text-soft py-4">No appointments found.</td></tr> }
        </tbody>
    </table>
</div>
