@model Patient
@{
    ViewData["Title"] = "Register Patient";
}

<div class="page-heading">
    <div>
        <div class="page-kicker">Reception workflow</div>
        <h1>Register patient</h1>
        <p class="text-soft mb-0">A unique hospital number is generated automatically by Supabase.</p>
    </div>
</div>

<form method="post" class="form-shell">
    <partial name="_PatientForm" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button class="btn btn-primary" type="submit"><i class="bi bi-check2 me-2"></i>Save patient</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
