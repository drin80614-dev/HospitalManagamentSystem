@model IReadOnlyList<Payment>
@{
    var totalAmount = Model.Sum(item => item.TotalAmount);
    var paidAmount = Model.Sum(item => item.Amount);
    var balanceAmount = Model.Sum(item => item.BalanceAmount);
}
<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="mini-stat"><span>Total treatments</span><strong>@totalAmount.ToString("C")</strong><small>All billed services</small></div>
    </div>
    <div class="col-md-4">
        <div class="mini-stat"><span>Paid</span><strong>@paidAmount.ToString("C")</strong><small>Money received</small></div>
    </div>
    <div class="col-md-4">
        <div class="mini-stat"><span>Remaining</span><strong class="@(balanceAmount > 0 ? "text-danger" : "text-success")">@balanceAmount.ToString("C")</strong><small>Unpaid balance</small></div>
    </div>
</div>
<div class="table-responsive">
    <table class="table">
        <thead><tr><th>Date</th><th>Service</th><th>Total</th><th>Paid</th><th>Remaining</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PaymentDate.ToString("dd MMM yyyy")</td>
                <td>@item.ServiceName</td>
                <td>@item.TotalAmount.ToString("C")</td>
                <td>@item.Amount.ToString("C")</td>
                <td class="@(item.BalanceAmount > 0 ? "text-danger fw-bold" : "text-success fw-semibold")">@item.BalanceAmount.ToString("C")</td>
                <td><span class="badge-soft status-@item.Status">@item.Status</span></td>
            </tr>
        }
        @if (!Model.Any()) { <tr><td colspan="6" class="text-soft text-center py-4">No payments yet.</td></tr> }
        </tbody>
    </table>
</div>
