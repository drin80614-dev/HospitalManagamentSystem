@model IReadOnlyList<Payment>
<div class="table-responsive">
    <table class="table">
        <thead><tr><th>Date</th><th>Service</th><th>Amount</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr><td>@item.PaymentDate.ToString("dd MMM yyyy")</td><td>@item.ServiceName</td><td>@item.Amount.ToString("C")</td><td><span class="badge-soft status-@item.Status">@item.Status</span></td></tr>
        }
        @if (!Model.Any()) { <tr><td colspan="4" class="text-soft text-center py-4">No payments yet.</td></tr> }
        </tbody>
    </table>
</div>
