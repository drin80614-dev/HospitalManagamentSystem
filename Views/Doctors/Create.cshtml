@model Doctor
@{ ViewData["Title"] = "Create Doctor"; }
<div class="page-heading"><div><div class="page-kicker">Admin</div><h1>Create doctor</h1></div></div>
<form method="post" class="form-shell">
    <partial name="_DoctorForm" model="Model" />
    <div class="mt-4 d-flex gap-2"><button class="btn btn-primary">Save doctor</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
