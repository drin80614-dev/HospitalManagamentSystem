@model PaymentCreateViewModel
@{ ViewData["Title"] = "Register Payment"; }

<div class="page-heading">
    <div>
        <div class="page-kicker">Reception billing</div>
        <h1>Register payment</h1>
        <p class="text-soft mb-0">Select one or more dental services and register them in a single payment.</p>
    </div>
</div>

<form method="post" class="form-shell">
    <input type="hidden" asp-for="Payment.Status" value="Paid" />
    <input type="hidden" asp-for="Payment.ServiceId" id="Payment_ServiceId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-lg-6">
            <label asp-for="Payment.PatientId" class="form-label">Patient</label>
            <select asp-for="Payment.PatientId" class="form-select">
                <option value="">Select patient</option>
                @foreach (var patient in Model.Patients)
                {
                    <option value="@patient.Id">@patient.FullName - @patient.HospitalNumber</option>
                }
            </select>
        </div>
        <div class="col-lg-6">
            <label asp-for="ServiceIds" class="form-label">Services / Treatments</label>
            <div class="input-group">
                <select class="form-select" id="serviceSelect">
                    <option value="">Select service</option>
                    @foreach (var service in Model.Services)
                    {
                        <option value="@service.Id" data-name="@service.ServiceName" data-price="@service.Price" data-display-price="@service.Price.ToString("C")">@service.ServiceName - @service.Price.ToString("C")</option>
                    }
                </select>
                <button class="btn btn-outline-primary" type="button" id="addServiceButton"><i class="bi bi-plus-lg me-1"></i>Add</button>
            </div>
            <div class="selected-services mt-2" id="selectedServices">
                @foreach (var service in Model.Services)
                {
                    if (!Model.ServiceIds.Contains(service.Id))
                    {
                        continue;
                    }

                    <div class="alert alert-light border d-flex justify-content-between align-items-center py-2 px-3 mb-2 selected-service" data-service-id="@service.Id" data-service-price="@service.Price">
                        <input type="hidden" name="ServiceIds" value="@service.Id" />
                        <span><strong>@service.ServiceName</strong> <span class="text-soft">@service.Price.ToString("C")</span></span>
                        <button type="button" class="btn btn-sm btn-outline-danger remove-service"><i class="bi bi-x-lg"></i></button>
                    </div>
                }
            </div>
            <div class="form-text">Add all services, then enter how much the patient pays now.</div>
            <span asp-validation-for="ServiceIds" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Payment.TotalAmount" class="form-label">Total treatment price</label>
            <input asp-for="Payment.TotalAmount" type="number" step="0.01" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Payment.Amount" class="form-label">Paid now</label>
            <input asp-for="Payment.Amount" type="number" step="0.01" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Remaining</label>
            <div class="form-control bg-light fw-bold" id="remainingPreview">0.00</div>
        </div>
        <div class="col-md-3"><label asp-for="Payment.PaymentMethod" class="form-label"></label><select asp-for="Payment.PaymentMethod" class="form-select"><option>Cash</option><option>Card</option><option>Bank Transfer</option></select></div>
        <div class="col-md-4"><label asp-for="Payment.PaymentDate" class="form-label"></label><input asp-for="Payment.PaymentDate" class="form-control" /></div>
        <div class="col-md-4">
            <label class="form-label">Status</label>
            <div class="form-control bg-light text-soft">Auto calculated</div>
            <div class="form-text">Nese ka mbetje, ruhet si "E paguar pjeserisht".</div>
        </div>
        <div class="col-12"><label asp-for="Payment.Notes" class="form-label"></label><textarea asp-for="Payment.Notes" class="form-control" rows="4"></textarea></div>
    </div>
    <div class="mt-4"><button class="btn btn-primary"><i class="bi bi-receipt me-2"></i>Register payment</button></div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const serviceSelect = document.getElementById("serviceSelect");
        const addServiceButton = document.getElementById("addServiceButton");
        const selectedServices = document.getElementById("selectedServices");
        const totalInput = document.getElementById("Payment_TotalAmount");
        const paidInput = document.getElementById("Payment_Amount");
        const remainingPreview = document.getElementById("remainingPreview");
        const primaryServiceInput = document.getElementById("Payment_ServiceId");

        const numberValue = value => Number(String(value || "0").replace(",", ".")) || 0;
        const getSelectedRows = () => Array.from(selectedServices.querySelectorAll(".selected-service"));
        const getSelectedIds = () => Array.from(selectedServices.querySelectorAll("input[name='ServiceIds']")).map(input => input.value);

        const updateTotals = () => {
            const rows = getSelectedRows();
            const total = rows.reduce((sum, row) => sum + numberValue(row.dataset.servicePrice), 0);
            if (rows.length) {
                totalInput.value = total.toFixed(2);
                primaryServiceInput.value = rows[0].dataset.serviceId || "";
            } else {
                primaryServiceInput.value = "";
            }

            const remaining = Math.max(numberValue(totalInput.value) - numberValue(paidInput.value), 0);
            remainingPreview.textContent = `${remaining.toFixed(2)} EUR`;
        };

        const syncOptions = () => {
            const ids = getSelectedIds();
            Array.from(serviceSelect.options).forEach(option => {
                option.disabled = option.value !== "" && ids.includes(option.value);
            });
            serviceSelect.value = "";
            updateTotals();
        };

        const addSelectedService = () => {
            const option = serviceSelect.options[serviceSelect.selectedIndex];
            if (!option?.value || getSelectedIds().includes(option.value)) {
                return;
            }

            const row = document.createElement("div");
            row.className = "alert alert-light border d-flex justify-content-between align-items-center py-2 px-3 mb-2 selected-service";
            row.dataset.serviceId = option.value;
            row.dataset.servicePrice = option.dataset.price || "0";

            const hidden = document.createElement("input");
            hidden.type = "hidden";
            hidden.name = "ServiceIds";
            hidden.value = option.value;

            const label = document.createElement("span");
            const name = document.createElement("strong");
            name.textContent = option.dataset.name || option.textContent.trim();
            const price = document.createElement("span");
            price.className = "text-soft";
            price.textContent = ` ${option.dataset.displayPrice || option.dataset.price || ""}`;
            label.append(name, price);

            const remove = document.createElement("button");
            remove.type = "button";
            remove.className = "btn btn-sm btn-outline-danger remove-service";
            remove.innerHTML = '<i class="bi bi-x-lg"></i>';

            row.append(hidden, label, remove);
            selectedServices.append(row);
            syncOptions();
        };

        addServiceButton?.addEventListener("click", addSelectedService);
        serviceSelect?.addEventListener("keydown", event => {
            if (event.key === "Enter") {
                event.preventDefault();
                addSelectedService();
            }
        });
        selectedServices?.addEventListener("click", event => {
            const button = event.target.closest(".remove-service");
            if (!button) {
                return;
            }

            button.closest(".selected-service")?.remove();
            syncOptions();
        });
        totalInput?.addEventListener("input", updateTotals);
        paidInput?.addEventListener("input", updateTotals);
        syncOptions();
    </script>
}
