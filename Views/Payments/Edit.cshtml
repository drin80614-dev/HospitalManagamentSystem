@model PaymentEditViewModel
@{ ViewData["Title"] = "Edit Payment"; }

<div class="page-heading">
    <div>
        <div class="page-kicker">Billing control</div>
        <h1>Edit payment</h1>
        <p class="text-soft mb-0">Update the remaining balance when the patient pays later.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-2"></i>Back to payments</a>
</div>

<div class="form-shell">
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="mini-stat">
                <span>Patient</span>
                <strong>@Model.PatientName</strong>
                <small>@Model.HospitalNumber</small>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mini-stat">
                <span>Service</span>
                <strong>@Model.ServiceName</strong>
                <small>@Model.PaymentDate.ToString("dd MMM yyyy HH:mm")</small>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mini-stat">
                <span>Financial balance</span>
                <strong>@Model.Amount.ToString("C") paid</strong>
                <small>Total @Model.TotalAmount.ToString("C") / remaining @Model.BalanceAmount.ToString("C")</small>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mini-stat">
                <span>Current status</span>
                <strong>
                    <span class="badge-soft status-@(Model.Status == "Cancelled" ? "Cancelled" : Model.BalanceAmount > 0 ? "Pending" : "Paid")">
                        @(Model.Status == "Cancelled" ? "Anuluar" : Model.BalanceAmount > 0 ? "E paguar pjeserisht" : "E paguar e gjitha")
                    </span>
                </strong>
                <small>Status updates automatically from remaining balance.</small>
            </div>
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="TotalAmount" class="form-label">Totali i pageses</label>
                <input asp-for="TotalAmount" class="form-control" readonly />
            </div>
            <div class="col-md-4">
                <label asp-for="Amount" class="form-label">Shuma e paguar</label>
                <input asp-for="Amount" class="form-control" readonly />
            </div>
            <div class="col-md-4">
                <label asp-for="BalanceAmount" class="form-label">Shuma e papaguar / mbetur</label>
                <input asp-for="BalanceAmount" class="form-control" type="number" step="0.01" min="0" max="@Model.TotalAmount" />
                <span asp-validation-for="BalanceAmount" class="text-danger"></span>
                <div class="form-text">Kur mbetja behet 0, statusi kalon ne "E paguar e gjitha".</div>
            </div>
            <div class="col-md-4">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option>Paid</option>
                    <option>Pending</option>
                    <option>Cancelled</option>
                </select>
                <div class="form-text">Paid/Pending llogariten nga mbetja; Cancelled perdoret vetem per anulim.</div>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary"><i class="bi bi-check2-circle me-2"></i>Save changes</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
