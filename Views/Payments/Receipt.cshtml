@model Invoice
@{
    ViewData["Title"] = "Receipt";
    string Money(decimal value) => $"{value:N2} EUR";
    var paymentLabel = Model.Status == "Cancelled" ? "Anuluar" : Model.BalanceAmount > 0 ? "E paguar pjeserisht" : "E paguar e gjitha";
}

<div class="page-heading no-print">
    <div><div class="page-kicker">Printable invoice</div><h1>Receipt</h1></div>
    <button class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer me-2"></i>Print receipt</button>
</div>

<div class="print-surface">
    <div class="print-document-header">
        <div class="d-flex align-items-center gap-3">
            <img class="print-logo" src="~/img/vlera-dent-logo.svg" alt="Vlera Dent" />
            <div>
                <h2 class="fw-bold mb-1">Vlera Dent</h2>
                <p class="mb-0 text-soft">Ordinance stomatologjike</p>
            </div>
        </div>
        <div class="text-end">
            <div class="fw-bold text-uppercase">Receipt</div>
            <div>@Model.InvoiceNumber</div>
            <div class="text-soft">@Model.InvoiceDate.ToString("dd MMM yyyy HH:mm")</div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6"><div class="print-info"><span>Patient</span><strong>@Model.PatientName</strong><small>@Model.HospitalNumber</small></div></div>
        <div class="col-md-6"><div class="print-info"><span>Payment</span><strong>@paymentLabel</strong><small>@Model.PaymentMethod</small></div></div>
    </div>

    <table class="table print-table">
        <thead><tr><th>Service</th><th class="text-end">Total</th></tr></thead>
        <tbody>
            <tr><td>@Model.ServiceName</td><td class="text-end">@Money(Model.TotalAmount)</td></tr>
        </tbody>
    </table>

    <div class="print-total-box">
        <div><span>Total service price</span><strong>@Money(Model.TotalAmount)</strong></div>
        <div><span>Paid now</span><strong>@Money(Model.PaidAmount)</strong></div>
        <div class="remaining"><span>Remaining balance</span><strong>@Money(Model.BalanceAmount)</strong></div>
    </div>

    <div class="print-signature-row">
        <div>Patient signature</div>
        <div>Clinic signature</div>
    </div>

    <p class="text-center text-soft mt-4 mb-0">Thank you. This receipt was generated by Vlera Dent.</p>
</div>
