@model Invoice
@{ ViewData["Title"] = "Receipt"; }

<div class="page-heading no-print">
    <div><div class="page-kicker">Printable invoice</div><h1>Receipt</h1></div>
    <button class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer me-2"></i>Print receipt</button>
</div>

<div class="print-surface">
    <div class="d-flex justify-content-between border-bottom pb-4 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Vlera Dent</h2>
            <p class="mb-0">Pristina, Kosovo</p>
        </div>
        <div class="text-end">
            <div class="fw-bold">Receipt</div>
            <div>@Model.InvoiceNumber</div>
            <div>@Model.InvoiceDate.ToString("dd MMM yyyy HH:mm")</div>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-6"><strong>Patient</strong><br />@Model.PatientName<br /><span>@Model.HospitalNumber</span></div>
        <div class="col-md-6"><strong>Payment method</strong><br />@Model.PaymentMethod<br /><span>@Model.Status</span></div>
    </div>
    <table class="table">
        <thead><tr><th>Service</th><th class="text-end">Amount</th></tr></thead>
        <tbody><tr><td>@Model.ServiceName</td><td class="text-end">@Model.TotalAmount.ToString("C")</td></tr></tbody>
        <tfoot><tr><th>Total</th><th class="text-end">@Model.TotalAmount.ToString("C")</th></tr></tfoot>
    </table>
    <p class="text-center mt-5 mb-0">Thank you. This receipt was generated by Vlera Dent.</p>
</div>
