@model IReadOnlyList<Payment>
@{ ViewData["Title"] = "Payments"; }

<div class="page-heading">
    <div><div class="page-kicker">Billing</div><h1>Payments</h1></div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-receipt me-2"></i>Register payment</a>
</div>

<div class="table-shell">
    <table class="table align-middle">
        <thead><tr><th>Patient</th><th>Service</th><th>Total</th><th>Paid</th><th>Remaining</th><th>Method</th><th>Date</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@item.PatientName</strong><br /><span class="text-soft">@item.HospitalNumber</span></td>
                <td>@item.ServiceName</td>
                <td>@item.TotalAmount.ToString("C")</td>
                <td>@item.Amount.ToString("C")</td>
                <td class="@(item.BalanceAmount > 0 ? "text-danger fw-bold" : "text-success fw-semibold")">@item.BalanceAmount.ToString("C")</td>
                <td>@item.PaymentMethod</td>
                <td>@item.PaymentDate.ToString("dd MMM yyyy HH:mm")</td>
                <td><span class="badge-soft status-@item.PaymentStatusCss">@item.PaymentStatusLabel</span></td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">
                        <i class="bi bi-pencil-square me-1"></i>Edit
                    </a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Receipt" asp-route-paymentId="@item.Id">
                        <i class="bi bi-printer me-1"></i>Receipt
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
