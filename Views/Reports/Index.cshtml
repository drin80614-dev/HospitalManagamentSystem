@model ReportsViewModel
@{ ViewData["Title"] = "Reports"; }

<div class="page-heading">
    <div><div class="page-kicker">Admin analytics</div><h1>Reports</h1></div>
    <button class="btn btn-outline-primary no-print" onclick="window.print()"><i class="bi bi-printer me-2"></i>Print</button>
</div>

<form method="get" class="glass-panel p-3 mb-4 no-print">
    <div class="row g-3 align-items-end">
        <div class="col-md-4"><label class="form-label">From</label><input class="form-control" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-4"><label class="form-label">To</label><input class="form-control" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-4 d-flex gap-2">
            <button class="btn btn-primary flex-fill"><i class="bi bi-funnel me-2"></i>Apply</button>
            <a class="btn btn-outline-secondary" asp-action="ExportCsv" asp-route-type="payments" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")"><i class="bi bi-download"></i></a>
        </div>
    </div>
</form>

<div class="row g-4">
    <div class="col-xl-6">
        <div class="table-shell">
            <div class="p-3 d-flex justify-content-between"><h5 class="fw-bold mb-0">Daily patients</h5><a class="btn btn-sm btn-outline-primary no-print" asp-action="ExportCsv" asp-route-type="patients" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">CSV</a></div>
            <table class="table"><thead><tr><th>Date</th><th>Registered</th><th>Admitted</th><th>Discharged</th></tr></thead><tbody>@foreach (var r in Model.DailyPatients){<tr><td>@r.ReportDate.ToString("dd MMM yyyy")</td><td>@r.RegisteredPatients</td><td>@r.AdmittedPatients</td><td>@r.DischargedPatients</td></tr>}</tbody></table>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="table-shell">
            <div class="p-3"><h5 class="fw-bold mb-0">Payments</h5></div>
            <table class="table"><thead><tr><th>Date</th><th>Method</th><th>Status</th><th>Total</th><th>Paid</th><th>Remaining</th></tr></thead><tbody>@foreach (var r in Model.Payments){<tr><td>@r.PaymentDate.ToString("dd MMM")</td><td>@r.PaymentMethod</td><td>@r.Status</td><td>@r.TotalAmount.ToString("C")</td><td>@r.PaidAmount.ToString("C")</td><td>@r.BalanceAmount.ToString("C")</td></tr>}</tbody></table>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="table-shell">
            <div class="p-3 d-flex justify-content-between"><h5 class="fw-bold mb-0">Doctor performance</h5><a class="btn btn-sm btn-outline-primary no-print" asp-action="ExportCsv" asp-route-type="doctors" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")">CSV</a></div>
            <table class="table"><thead><tr><th>Dentist</th><th>Visits</th><th>Prescriptions</th></tr></thead><tbody>@foreach (var r in Model.DoctorPerformance){<tr><td>@r.DoctorName</td><td>@r.VisitsCompleted</td><td>@r.PrescriptionsCreated</td></tr>}</tbody></table>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="table-shell">
            <div class="p-3"><h5 class="fw-bold mb-0">Appointment report</h5></div>
            <table class="table"><thead><tr><th>Date</th><th>Status</th><th>Count</th></tr></thead><tbody>@foreach (var r in Model.Appointments){<tr><td>@r.AppointmentDate.ToString("dd MMM")</td><td>@r.Status</td><td>@r.AppointmentCount</td></tr>}</tbody></table>
        </div>
    </div>
</div>
