@model MedicationInventoryItem

<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="MedicationName" class="form-label"></label><input asp-for="MedicationName" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Category" class="form-label"></label><input asp-for="Category" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Unit" class="form-label"></label><input asp-for="Unit" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="QuantityInStock" class="form-label"></label><input asp-for="QuantityInStock" type="number" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="ReorderLevel" class="form-label"></label><input asp-for="ReorderLevel" type="number" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="ExpiryDate" class="form-label"></label><input asp-for="ExpiryDate" type="date" class="form-control" /></div>
    <div class="col-md-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Available</option><option>Low Stock</option><option>Reserved</option><option>Expired</option></select></div>
    <div class="col-12"><label asp-for="Supplier" class="form-label"></label><input asp-for="Supplier" class="form-control" /></div>
</div>
