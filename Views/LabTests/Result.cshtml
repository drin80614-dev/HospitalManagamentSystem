@model LabResultViewModel
@{ ViewData["Title"] = "Lab Result"; }

<div class="page-heading">
    <div>
        <div class="page-kicker">Lab workflow</div>
        <h1>Update lab result</h1>
        <p class="text-soft mb-0">@Model.TestName for @Model.PatientName</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left me-2"></i>Back</a>
</div>

<form method="post" class="form-shell">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3 mb-3">
        <div class="col-md-4"><div class="mini-stat"><span>Patient</span><strong>@Model.PatientName</strong><small>@Model.DoctorName</small></div></div>
        <div class="col-md-4"><div class="mini-stat"><span>Test</span><strong>@Model.TestName</strong><small>@Model.TestType</small></div></div>
        <div class="col-md-4"><div class="mini-stat"><span>Status</span><strong>@Model.Status</strong><small>Requested / In Progress / Completed</small></div></div>
    </div>
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Requested</option><option>In Progress</option><option>Completed</option></select></div>
        <div class="col-md-4"><label asp-for="ResultDate" class="form-label"></label><input asp-for="ResultDate" type="date" class="form-control" /></div>
        <div class="col-12"><label asp-for="Result" class="form-label"></label><textarea asp-for="Result" class="form-control" rows="6"></textarea></div>
    </div>
    <button class="btn btn-primary mt-4"><i class="bi bi-check2-circle me-2"></i>Save result</button>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
