@{
    ViewData["Title"] = "Access denied";
}

<section class="min-vh-100 d-flex align-items-center justify-content-center p-4">
    <div class="empty-state" style="max-width: 620px">
        <div class="brand-mark mx-auto mb-3"><i class="bi bi-shield-lock"></i></div>
        <h1 class="fw-bold">Access denied</h1>
        <p class="text-soft">Your current role does not have permission to open this hospital workspace.</p>
        <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a>
    </div>
</section>
