@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<section class="min-vh-100 d-flex align-items-center p-3 p-lg-5">
    <div class="container">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-7">
                <div class="auth-hero-panel h-100 glass-panel p-4 p-lg-5">
                    <div class="auth-hero-top">
                        <div class="auth-logo-card">
                            <img class="login-brand-logo" src="~/img/vlera-dent-logo.svg" alt="Vlera Dent" />
                        </div>
                        <div>
                            <div class="page-kicker">Platforme per menaxhimin e ordinances stomatologjike</div>
                            <h1 class="display-4 fw-bold mb-2">Vlera Dent</h1>
                            <p class="lead text-soft mb-0">
                                Hapesire moderne pune per admin, stomatologe dhe recepsion.
                            </p>
                        </div>
                    </div>

                    <div class="auth-hero-grid mt-4">
                        <div class="auth-feature-card featured">
                            <i class="bi bi-calendar2-check"></i>
                            <div>
                                <span>Termine</span>
                                <strong>Orar i qarte</strong>
                                <small>Kontroll per sot, neser dhe ndryshime te shpejta.</small>
                            </div>
                        </div>
                        <div class="auth-feature-card">
                            <i class="bi bi-person-vcard"></i>
                            <div>
                                <span>Pacientet</span>
                                <strong>Kartela digjitale</strong>
                                <small>Historik, trajtime dhe pagesa ne nje vend.</small>
                            </div>
                        </div>
                        <div class="auth-feature-card">
                            <i class="bi bi-receipt-cutoff"></i>
                            <div>
                                <span>Pagesa</span>
                                <strong>Me shume sherbime</strong>
                                <small>Total, paguar dhe borxh i mbetur automatikisht.</small>
                            </div>
                        </div>
                        <div class="auth-feature-card">
                            <i class="bi bi-bar-chart-line"></i>
                            <div>
                                <span>Raporte</span>
                                <strong>Pasqyre mujore</strong>
                                <small>Te hyra, borxhe, termine dhe sherbimet kryesore.</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="form-shell h-100">
                    <div class="mb-4">
                        <div class="page-kicker">Staff access</div>
                        <h2 class="fw-bold mb-1">Sign in</h2>
                        <p class="text-soft mb-0">Use your clinic account to continue.</p>
                    </div>
                    <form asp-action="Login" method="post" class="d-grid gap-3">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <div>
                            <label asp-for="Login" class="form-label fw-semibold"></label>
                            <input asp-for="Login" class="form-control form-control-lg" autocomplete="username" />
                            <span asp-validation-for="Login" class="text-danger small"></span>
                        </div>
                        <div>
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">Keep me signed in for this shift</label>
                        </div>
                        <a class="small fw-semibold" asp-action="ForgotPassword">Forgot password?</a>
                        <button class="btn btn-primary btn-lg" type="submit">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Login
                        </button>
                    </form>
                    <div class="alert alert-info mt-4 mb-0">
                        <strong>Seed users after SQL setup:</strong><br />
                        admin@vleradent.com / Admin123!<br />
                        vlorentina.sahiti@vleradent.com / Doctor123!<br />
                        reception@vleradent.com / Reception123!
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
