@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; }

<section class="min-vh-100 d-flex align-items-center justify-content-center p-3">
    <div class="form-shell" style="max-width: 560px; width: 100%">
        <div class="page-kicker">Secure reset</div>
        <h1 class="fw-bold">Create new password</h1>
        <form method="post" class="d-grid gap-3">
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div>
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control form-control-lg" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control form-control-lg" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button class="btn btn-primary btn-lg">Reset password</button>
        </form>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
