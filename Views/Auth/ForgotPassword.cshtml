@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot Password"; }

<section class="min-vh-100 d-flex align-items-center justify-content-center p-3">
    <div class="form-shell" style="max-width: 560px; width: 100%">
        <div class="page-kicker">Account recovery</div>
        <h1 class="fw-bold">Reset password</h1>
        <p class="text-soft">Enter your account email. In this local build, the reset link is shown on-screen.</p>
        <form method="post" class="d-grid gap-3">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div>
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control form-control-lg" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button class="btn btn-primary btn-lg">Generate reset link</button>
            <a asp-action="Login">Back to login</a>
        </form>
        @if (TempData["ResetLink"] is string resetLink)
        {
            <div class="alert alert-warning mt-4">
                <strong>Development reset link:</strong><br />
                <a href="@resetLink">@resetLink</a>
            </div>
        }
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
