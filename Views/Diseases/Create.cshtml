@model Disease
@{ ViewData["Title"] = "Create Disease"; }

<div class="page-heading">
    <div><div class="page-kicker">Clinical reference</div><h1>Create disease</h1></div>
</div>

<form method="post" class="form-shell">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="DiseaseName" class="form-label"></label><input asp-for="DiseaseName" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Category" class="form-label"></label><input asp-for="Category" class="form-control" /></div>
        <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div>
        <div class="col-12"><label asp-for="CommonSymptoms" class="form-label"></label><textarea asp-for="CommonSymptoms" class="form-control" rows="4"></textarea></div>
    </div>
    <div class="mt-4"><button class="btn btn-primary">Save disease</button></div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
