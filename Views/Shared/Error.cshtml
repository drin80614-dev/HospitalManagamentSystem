@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="empty-state">
    <i class="bi bi-shield-exclamation display-4 text-primary"></i>
    <div class="page-kicker mt-3">Kodi @Model.StatusCode</div>
    <h1 class="fw-bold mt-2">@Model.Title</h1>
    <p class="text-soft mb-4">@Model.Message</p>
    <div class="quick-actions justify-content-center">
        <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid me-2"></i>Paneli</a>
        <a class="btn btn-outline-primary" asp-controller="Patients" asp-action="Index"><i class="bi bi-search me-2"></i>Pacientet</a>
    </div>
    @if (Model.ShowRequestId)
    {
        <p class="text-soft small mt-4 mb-0">Request ID: <code>@Model.RequestId</code></p>
    }
</div>
