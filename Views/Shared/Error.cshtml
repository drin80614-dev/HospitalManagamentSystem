@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="empty-state">
    <i class="bi bi-shield-exclamation display-4 text-primary"></i>
    <h1 class="fw-bold mt-3">Something went wrong</h1>
    <p class="text-soft mb-4">The page could not be loaded right now, but the system is still running. Please go back to the dashboard and try again.</p>
    <div class="quick-actions justify-content-center">
        <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid me-2"></i>Dashboard</a>
        <a class="btn btn-outline-primary" asp-controller="Patients" asp-action="Index"><i class="bi bi-search me-2"></i>Patients</a>
    </div>
    @if (Model.ShowRequestId)
    {
        <p class="text-soft small mt-4 mb-0">Request ID: <code>@Model.RequestId</code></p>
    }
</div>
